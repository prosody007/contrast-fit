{
  "name": "contrast-fit",
  "version": "0.1.0",
  "description": "Generate deterministic, contrast-fitted UI color tokens from a background color.",
  "type": "module",
  "sideEffects": [
    "./dist/contrast-fit.global.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/contrast-fit.cjs",
  "types": "./dist/contrast-fit.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/contrast-fit.d.ts",
        "default": "./dist/contrast-fit.js"
      },
      "require": {
        "types": "./dist/contrast-fit.d.cts",
        "default": "./dist/contrast-fit.cjs"
      },
      "default": "./dist/contrast-fit.js"
    },
    "./browser": "./dist/contrast-fit.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs/api.md",
    "docs/architecture.md",
    "README.md",
    "MIGRATING.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "npm run check && npm run build:lib && node scripts/build-static.mjs && node scripts/check-static.mjs",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 test/*.test.js",
    "check": "node scripts/check-syntax.mjs",
    "typecheck": "npm run build:lib && tsc -p tsconfig.json",
    "package:check": "npm pack --dry-run",
    "package:smoke": "node scripts/package-smoke.mjs",
    "test:browser": "node test/browser/dashboard-smoke.mjs",
    "verify": "npm run check && npm run typecheck && npm run test:coverage && npm run build && npm run check:naming && npm run package:smoke",
    "prepack": "npm run build:lib && npm run check:naming",
    "build:lib": "node scripts/build-library.mjs",
    "check:naming": "node scripts/check-naming.mjs"
  },
  "keywords": [
    "color",
    "accessibility",
    "wcag",
    "dark-mode",
    "design-tokens",
    "data-visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prosody007/contrast-fit.git"
  },
  "bugs": {
    "url": "https://github.com/prosody007/contrast-fit/issues"
  },
  "homepage": "https://github.com/prosody007/contrast-fit#readme",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "module": "./dist/contrast-fit.js",
  "browser": "./dist/contrast-fit.js",
  "unpkg": "./dist/contrast-fit.global.js",
  "jsdelivr": "./dist/contrast-fit.global.js"
}
